{
  "manifest_version": 3,
  "name": "Correo Calendario",
  "version": "0.7.2",
  "description": "Programa correos y felicitaciones desde Thunderbird, con listas CC/CCO, agenda, plantillas HTML y fotos.",
  "author": "Correo Calendario · Agradecimientos a Luis Manuel Fajardo",
  "browser_specific_settings": {
    "gecko": {
      "id": "correo-calendario@local.addon",
      "strict_min_version": "153.0",
      "update_url": "https://lordmanuel.github.io/automail/updates.json"
    }
  },
  "permissions": [
    "accountsRead",
    "compose",
    "compose.send",
    "addressBooks",
    "storage",
    "alarms",
    "tabs",
    "notifications",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": [
      "email-css.js",
      "defaults.js",
      "photo-db.js",
      "poster.js",
      "contact-profile.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Abrir Correo Calendario",
    "default_icon": "icons/icon-32.png"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  }
}
